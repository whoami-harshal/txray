# Helius (free plan: 1M credits/mo, 10 req/s) — https://dashboard.helius.dev
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/track?secret=...
CRON_SECRET=

# Optional: max RPC requests/second for the Checkup (default 8, Helius free plan allows 10)
RPC_MAX_RPS=

# Optional showcase mode: dashboard shows only this project (demo data) with a banner
DEMO_PROJECT_ID=

# Optional: max fresh checkups per 24h across all visitors (default 150; ~760 Helius credits each on the free plan)
CHECKUP_DAILY_LIMIT=

# Optional: links in the site footer
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
